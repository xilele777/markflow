# 复制为仓库根 .env 后按需修改。所有口令仅用于本地开发，切勿用于生产。
# 后端启动时读取仓库根 .env（不存在则只读进程环境变量）。

# ---- 服务 ----
LINGSHU_SERVER_PORT=8080
# pino 日志级别：trace / debug / info / warn / error / silent
LINGSHU_LOG_LEVEL=info
# Express trust proxy：false（直连）/ loopback（本机 Nginx 反代）/ 1（一层反代）
LINGSHU_TRUST_PROXY=false

# ---- PostgreSQL（compose 与后端共用）----
LINGSHU_PG_HOST=127.0.0.1
LINGSHU_PG_PORT=5432
LINGSHU_PG_DB=lingshu
LINGSHU_PG_USER=lingshu
LINGSHU_PG_PASSWORD=lingshu_dev_pwd

# ---- Redis（compose 与后端共用）----
LINGSHU_REDIS_HOST=127.0.0.1
LINGSHU_REDIS_PORT=6379
LINGSHU_REDIS_PASSWORD=lingshu_dev_pwd

# ---- MinIO（compose 用；后端 M2 起使用 S3 兼容接口）----
LINGSHU_MINIO_ROOT_USER=lingshu-minio
LINGSHU_MINIO_ROOT_PASSWORD=lingshu_dev_pwd
LINGSHU_MINIO_PORT=9000
LINGSHU_MINIO_CONSOLE_PORT=9001
LINGSHU_S3_BUCKET=lingshu

# ---- 首启引导（只在 sys_config / sys_user 缺少对应记录时使用，之后修改无效）----
# JWT 密钥，至少 32 字符；生产用 openssl rand -base64 48 生成。
LINGSHU_JWT_SECRET=dev-only-jwt-secret-please-change-0123456789abcdef
LINGSHU_JWT_EXPIRE_SECONDS=86400
# 系统管理员账号（仅当该用户名不存在时创建）。
LINGSHU_ADMIN_USERNAME=admin
LINGSHU_ADMIN_INITIAL_PASSWORD=admin123456

# ---- 安全 ----
# 逗号分隔的前端来源（浏览器直连后端时才涉及；经 Vite / Nginx 同源代理时不涉及）。
LINGSHU_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 全局限流：每 IP 每分钟请求数上限
LINGSHU_RATE_LIMIT_GLOBAL_PER_MINUTE=600
# 登录失败限流：同一 IP + 用户名在窗口内失败次数上限
LINGSHU_RATE_LIMIT_LOGIN_MAX_FAILURES=5
LINGSHU_RATE_LIMIT_LOGIN_WINDOW_MINUTES=15

# ---- 敏感配置加密与时区 ----
# AI 配置 apiKey 等以 AES-256-GCM 加密后存入 sys_config；密钥至少 32 字符，生产用 openssl rand -base64 48 生成。
# 更换密钥后已加密的历史值将无法解密。
LINGSHU_CONFIG_ENC_KEY=dev-only-config-enc-key-please-change-0123456789abcdef
# 「我的贡献」按天统计使用的 IANA 时区（对应 Java 版 serverTimezone=Asia/Shanghai）
LINGSHU_TIMEZONE=Asia/Shanghai
