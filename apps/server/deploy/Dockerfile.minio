# Development / CI only. The upstream community registry and binary downloads
# are no longer available; build the same pinned releases from official source.
FROM golang:1.24.6-bookworm AS server-build
WORKDIR /src
ADD https://github.com/minio/minio/archive/07c3a429bfed433e49018cb0f78a52145d4bedeb.tar.gz /tmp/minio.tar.gz
RUN tar -xzf /tmp/minio.tar.gz --strip-components=1 -C /src
RUN CGO_ENABLED=0 go build -trimpath -o /out/minio .

FROM golang:1.24.6-bookworm AS client-build
WORKDIR /src
ADD https://github.com/minio/mc/archive/7394ce0dd2a80935aded936b09fa12cbb3cb8096.tar.gz /tmp/mc.tar.gz
RUN tar -xzf /tmp/mc.tar.gz --strip-components=1 -C /src
RUN CGO_ENABLED=0 go build -trimpath -o /out/mc .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=server-build /out/minio /usr/local/bin/minio
COPY --from=client-build /out/mc /usr/local/bin/mc
COPY --from=server-build /src/LICENSE /usr/share/licenses/minio/LICENSE
COPY --from=client-build /src/LICENSE /usr/share/licenses/mc/LICENSE
EXPOSE 9000 9001
ENTRYPOINT ["/usr/local/bin/minio"]
