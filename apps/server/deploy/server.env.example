# 生产模板：必填值留空，未填齐不能启动；不要复制开发口令。
NODE_ENV=production
LINGSHU_SERVER_HOST=127.0.0.1
LINGSHU_SERVER_PORT=8080
LINGSHU_LOG_LEVEL=info
LINGSHU_TRUST_PROXY=loopback
LINGSHU_TIMEZONE=Asia/Shanghai
LINGSHU_PG_HOST=127.0.0.1
LINGSHU_PG_PORT=5432
LINGSHU_PG_DB=lingshu
LINGSHU_PG_USER=lingshu
LINGSHU_PG_PASSWORD=
LINGSHU_REDIS_HOST=127.0.0.1
LINGSHU_REDIS_PORT=6379
LINGSHU_REDIS_PASSWORD=
LINGSHU_QUEUE_PREFIX=lingshu
LINGSHU_CONFIG_ENC_KEY=
LINGSHU_JWT_SECRET=
LINGSHU_JWT_EXPIRE_SECONDS=86400
LINGSHU_ADMIN_USERNAME=admin
LINGSHU_ADMIN_INITIAL_PASSWORD=
LINGSHU_CORS_ALLOWED_ORIGINS=https://app.example.com
LINGSHU_METRICS_TOKEN=
LINGSHU_S3_ENDPOINT=http://127.0.0.1:9000
LINGSHU_S3_PUBLIC_ENDPOINT=https://objects.example.com
LINGSHU_S3_REGION=us-east-1
LINGSHU_S3_BUCKET=lingshu
LINGSHU_S3_ACCESS_KEY=
LINGSHU_S3_SECRET_KEY=
LINGSHU_S3_FORCE_PATH_STYLE=true
