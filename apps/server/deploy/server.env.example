# 生产模板：必填值留空，未填齐不能启动；不要复制开发口令。
NODE_ENV=production
MARKFLOW_SERVER_HOST=127.0.0.1
MARKFLOW_SERVER_PORT=8080
MARKFLOW_LOG_LEVEL=info
MARKFLOW_TRUST_PROXY=loopback
MARKFLOW_TIMEZONE=Asia/Shanghai
MARKFLOW_PG_HOST=127.0.0.1
MARKFLOW_PG_PORT=5432
MARKFLOW_PG_DB=markflow
MARKFLOW_PG_USER=markflow
MARKFLOW_PG_PASSWORD=
MARKFLOW_REDIS_HOST=127.0.0.1
MARKFLOW_REDIS_PORT=6379
MARKFLOW_REDIS_PASSWORD=
MARKFLOW_QUEUE_PREFIX=markflow
MARKFLOW_CONFIG_ENC_KEY=
MARKFLOW_JWT_SECRET=
MARKFLOW_JWT_EXPIRE_SECONDS=86400
MARKFLOW_ADMIN_USERNAME=admin
MARKFLOW_ADMIN_INITIAL_PASSWORD=
MARKFLOW_CORS_ALLOWED_ORIGINS=https://app.example.com
MARKFLOW_METRICS_TOKEN=
MARKFLOW_S3_ENDPOINT=http://127.0.0.1:9000
MARKFLOW_S3_PUBLIC_ENDPOINT=https://objects.example.com
MARKFLOW_S3_REGION=us-east-1
MARKFLOW_S3_BUCKET=markflow
MARKFLOW_S3_ACCESS_KEY=
MARKFLOW_S3_SECRET_KEY=
MARKFLOW_S3_FORCE_PATH_STYLE=true
