# 复制为仓库根 .env 后按需修改。所有口令仅用于本地开发，切勿用于生产。
# 后端启动时读取仓库根 .env（不存在则只读进程环境变量）。

# ---- 服务 ----
MARKFLOW_SERVER_PORT=8080
MARKFLOW_SERVER_HOST=127.0.0.1
# 可选；至少 32 字符。未设置时 GET /api/metrics 返回 404；抓取用 Bearer token。
# MARKFLOW_METRICS_TOKEN=
# pino 日志级别：trace / debug / info / warn / error / silent
MARKFLOW_LOG_LEVEL=info
# Express trust proxy：false（直连）/ loopback（本机 Nginx 反代）/ 1（一层反代）
MARKFLOW_TRUST_PROXY=false

# ---- PostgreSQL（compose 与后端共用）----
MARKFLOW_PG_HOST=127.0.0.1
MARKFLOW_PG_PORT=5432
MARKFLOW_PG_DB=markflow
MARKFLOW_PG_USER=markflow
MARKFLOW_PG_PASSWORD=markflow_dev_pwd

# ---- Redis（compose 与后端共用）----
MARKFLOW_REDIS_HOST=127.0.0.1
MARKFLOW_REDIS_PORT=6379
MARKFLOW_REDIS_PASSWORD=markflow_dev_pwd

# ---- MinIO（compose 用）----
MARKFLOW_MINIO_ROOT_USER=markflow-minio
MARKFLOW_MINIO_ROOT_PASSWORD=markflow_dev_pwd
MARKFLOW_MINIO_PORT=9000
MARKFLOW_MINIO_CONSOLE_PORT=9001

# ---- 对象存储（S3 兼容；本地即上面的 MinIO，线上 MinIO 或火山 TOS 的 S3 端点）----
# 后端进程访问的地址（内网 / 本机）
MARKFLOW_S3_ENDPOINT=http://127.0.0.1:9000
# 浏览器直传访问的地址：预签名 URL 用它签名（SigV4 签 host），必须是浏览器实际可达的地址；
# 本机开发与前端同用 localhost；线上填公网域名（如 https://minio.example.com）。缺省与 MARKFLOW_S3_ENDPOINT 相同。
MARKFLOW_S3_PUBLIC_ENDPOINT=http://localhost:9000
MARKFLOW_S3_REGION=us-east-1
MARKFLOW_S3_BUCKET=markflow
# 访问凭据（本地即 MinIO root 账号；线上建议用只读写该桶的专用账号）
MARKFLOW_S3_ACCESS_KEY=markflow-minio
MARKFLOW_S3_SECRET_KEY=markflow_dev_pwd
# MinIO 为 true（路径风格 /bucket/key）；虚拟主机风格端点（TOS 等）填 false
MARKFLOW_S3_FORCE_PATH_STYLE=true

# ---- 队列（BullMQ，Redis 键前缀；多套环境共用一个 Redis 时改成不同前缀）----
MARKFLOW_QUEUE_PREFIX=markflow

# ---- 首启引导（只在 sys_config / sys_user 缺少对应记录时使用，之后修改无效）----
# JWT 密钥，至少 32 字符；生产用 openssl rand -base64 48 生成。
MARKFLOW_JWT_SECRET=dev-only-jwt-secret-please-change-0123456789abcdef
MARKFLOW_JWT_EXPIRE_SECONDS=86400
# 系统管理员账号（仅当该用户名不存在时创建）。
MARKFLOW_ADMIN_USERNAME=admin
MARKFLOW_ADMIN_INITIAL_PASSWORD=admin123456

# ---- 安全 ----
# 逗号分隔的前端来源（浏览器直连后端时才涉及；经 Vite / Nginx 同源代理时不涉及）。
MARKFLOW_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 全局限流：每 IP 每分钟请求数上限
MARKFLOW_RATE_LIMIT_GLOBAL_PER_MINUTE=600
# 登录失败限流：同一 IP + 用户名在窗口内失败次数上限
MARKFLOW_RATE_LIMIT_LOGIN_MAX_FAILURES=5
MARKFLOW_RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
# 前端性能上报（POST /api/monitoring/reportWebVitals，公开接口）：每 IP 每分钟上限
MARKFLOW_RATE_LIMIT_WEB_VITALS_PER_MINUTE=60

# ---- 敏感配置加密与时区 ----
# AI 配置 apiKey 等以 AES-256-GCM 加密后存入 sys_config；密钥至少 32 字符，生产用 openssl rand -base64 48 生成。
# 更换密钥后已加密的历史值将无法解密。
MARKFLOW_CONFIG_ENC_KEY=dev-only-config-enc-key-please-change-0123456789abcdef
# 「我的贡献」按天统计使用的 IANA 时区（对应 Java 版 serverTimezone=Asia/Shanghai）
MARKFLOW_TIMEZONE=Asia/Shanghai
